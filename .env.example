# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Default model for both pipeline calls (a request may name another; see GET /config).
MODEL=claude-sonnet-5
# Path to the committed corpus.
CORPUS_PATH=data/corpus.json
# Retrieval strategy: full (default: every recipe that passes the filters goes to the
# model, prompt-cached; ADR-002), bm25 (top-8 sections, use past ~80 recipes),
# or hybrid (BM25 + Voyage vectors, RRF fusion).
RETRIEVER=full
# A request body may override MODEL and RETRIEVER for that request only.
# Only needed for RETRIEVER=hybrid and for `python -m app.embeddings`.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
