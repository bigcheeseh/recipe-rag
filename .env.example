# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Model used for both pipeline calls and for ingestion enrichment.
MODEL=claude-sonnet-5
# Path to the committed corpus.
CORPUS_PATH=data/corpus.json
# Retrieval strategy: bm25 (default), hybrid (BM25 + Voyage vectors, RRF fusion),
# or full (no retrieval: every recipe that passes the filters goes to the model, cached).
RETRIEVER=bm25
# Only needed for RETRIEVER=hybrid and for `python -m app.embeddings`.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
